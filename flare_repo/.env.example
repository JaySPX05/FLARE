# Copy to .env (same folder) and adjust. .env is gitignored.
# Fill these in from the output of:  python live-ingest/probe_imd.py

# --- IMD access (approval is by whitelisted IP; a key is usually NOT needed) ---
IMD_BASE_URL=https://api.imd.gov.in/api/v1
# IMD_API_KEY=
# IMD_API_KEY_HEADER=Authorization

# --- What the feed looks like (probe_imd.py prints recommended values) ---
IMD_STATE_ID=13
IMD_NOWCAST_STATION=Bengaluru
# IMD_RAIN_FIELD=RAINFALL
IMD_RAIN_MODE=cumulative
IMD_TIME_ZONE=UTC

# --- Ingest behaviour ---
STATION_RADIUS_KM=30
POLL_MINUTES=15
FRAME_MINUTES=60
# legacy = demo pipeline thresholds (5/15/30 mm per 15 min); imd = 5/15/30 mm per hour
RAIN_THRESHOLD_SCHEME=legacy

# --- Which data the APIs serve: auto (live if available) | live | demo ---
FLARE_DATA_MODE=auto
